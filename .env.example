# Copie para .env e preencha. O .env NÃO é versionado.
# Lido pelo agente Sentinela, pelo portal cativo e pelos scripts de backup.

# Banco (Fase 3) — usuário dedicado, nunca root
MYSQL_HOST=127.0.0.1
MYSQL_USER=sentinela
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=vigia_de_rede

# Portal cativo (Fase 1.5) — senha compartilhada da rede
PORTAL_SENHA=troque-esta-senha

# Rede controlada (Fase 1)
REDE_SEGMENTO=192.168.50.0/24
REDE_GATEWAY=192.168.50.1
