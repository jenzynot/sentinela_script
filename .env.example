# Copie para .env e preencha. O .env NÃO é versionado.
# O instalar.sh copia este arquivo para /etc/sentinela/sentinela.env.
# Formato: CHAVE=valor (sem espaços em volta do "="; listas separadas por vírgula).

# --- Banco (Fases 3/4) — usuário dedicado, nunca root ------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sentinela
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=vigia_de_rede

# --- Rede controlada (Fase 1) -------------------------------------------------
# Placa Wi-Fi que vira AP (veja com `iw dev`). Ela sai do NetworkManager:
# a internet do host precisa vir de OUTRA interface (cabo, USB tethering...).
WIFI_IF=wlp2s0
WIFI_SSID=Sentinela
# 8 a 63 caracteres. Vazia = rede aberta (acesso controlado só pelo portal).
WIFI_SENHA=troque-esta-senha
WIFI_CANAL=6
WIFI_PAIS=BR

REDE_SEGMENTO=192.168.50.0/24
REDE_GATEWAY=192.168.50.1
REDE_DOMINIO=casa.lan
DHCP_INICIO=192.168.50.100
DHCP_FIM=192.168.50.200
DNS_UPSTREAM=1.1.1.1,9.9.9.9

# --- Portal cativo (Fase 1.5) — senha compartilhada do registro ---------------
PORTAL_SENHA=troque-esta-senha

# --- Agente Sentinela (Fase 5) -----------------------------------------------
SENTINELA_INTERFACE=br0
# segundos entre varreduras
SENTINELA_INTERVALO=60
# vazio = top 1000 portas do nmap; ou uma faixa, ex.: 1-1024,3389,8080
SENTINELA_PORTAS=
SENTINELA_LOG=/var/log/sentinela/sentinela.log
# E-mail de alerta (opcional): só liga com SMTP_HOST e ALERTA_EMAIL_PARA.
# Gmail: smtp.gmail.com / 587 / senha de app (não a senha da conta).
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
ALERTA_EMAIL_DE=
ALERTA_EMAIL_PARA=

# --- VPN WireGuard (Fase 6, opcional) ----------------------------------------
# IP público ou nome DDNS de onde o host está; o roteador da casa/faculdade
# precisa encaminhar 51820/udp para o host.
VPN_ENDPOINT=

# --- VM Windows Server (Fase 2) ----------------------------------------------
# ISO de avaliação (180 dias) do Microsoft Evaluation Center.
VM_ISO=/home/SEU_USUARIO/isos/windows_server_2019_eval.iso
VM_OSTYPE=Windows2019_64
# Edição dentro da ISO (veja com: python -m provision.vm imagens).
# Na ISO de avaliação, 2 = Standard com Desktop Experience.
VM_INDICE_IMAGEM=2
VM_NOME=servidor-casa
VM_MEMORIA_MB=4096
VM_CPUS=2
VM_DISCO_GB=60
VM_USUARIO=casa
# 8+ caracteres, 3 de: minúscula, maiúscula, dígito, símbolo; sem o usuário.
VM_SENHA=Troque-Esta-Senha-1
# MAC fixo -> IP fixo pelo dnsmasq + entrada na whitelist
VM_MAC=08:00:27:5e:00:10
VM_IP=192.168.50.10
