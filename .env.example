# Copie para .env e preencha. O .env NÃO é versionado.
# O instalar.sh copia este arquivo para /etc/sentinela/sentinela.env.
# Formato: CHAVE=valor (sem espaços em volta do "="; listas separadas por vírgula).

# --- Banco (Fases 3/4) — usuário dedicado, nunca root ------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sentinela
MYSQL_PASSWORD=troque-esta-senha
MYSQL_DATABASE=vigia_de_rede

# --- Rede controlada (Fase 1) -------------------------------------------------
# Placa Wi-Fi que vira AP (veja com `iw dev`). Ela sai do NetworkManager:
# a internet do host precisa vir de OUTRA interface (cabo, USB tethering...).
WIFI_IF=wlp2s0
WIFI_SSID=Sentinela
# 8 a 63 caracteres. Vazia = rede aberta (acesso controlado só pelo portal).
WIFI_SENHA=troque-esta-senha
WIFI_CANAL=6
WIFI_PAIS=BR

REDE_SEGMENTO=192.168.50.0/24
REDE_GATEWAY=192.168.50.1
REDE_DOMINIO=casa.lan
DHCP_INICIO=192.168.50.100
DHCP_FIM=192.168.50.200
DNS_UPSTREAM=1.1.1.1,9.9.9.9

# --- Portal cativo (Fase 1.5) — senha compartilhada do registro ---------------
PORTAL_SENHA=troque-esta-senha
